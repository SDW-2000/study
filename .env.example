# A single domain or IP only, without a scheme, path, or port.
# localhost is for local verification. Change this on the deployment server.
SITE_ADDRESS=localhost

# docker_setup.py fills these with independent random values on first setup.
# Do not commit or regenerate an existing deployed key.
SECRET_KEY=
ADMIN_PASSWORD=

# Optional initial note, used only when the admin account is first created.
# ADMIN_NOTE=SBOB{your_identifier}

# Administrator activity history retention, from 7 to 365 days.
AUDIT_RETENTION_DAYS=90

# Production defaults. Change the host ports only if forwarding is configured.
HTTP_PORT=80
HTTPS_PORT=443
BIND_IP=0.0.0.0
